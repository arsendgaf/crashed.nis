{
  "name": "crashed-nis",
  "version": "3.2.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun run turbo dev",
    "build": "bun run turbo build",
    "lint": "bun run turbo lint",
    "format": "bun run turbo format",
    "test": "bun run turbo test",
    "typecheck": "bun run turbo typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "picomatch": "^4.0.7",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,jsonc,bru}": [
      "bunx oxfmt --write"
    ],
    "{apps,packages}/**/*.{js,jsx,ts,tsx}": [
      "bunx oxlint --fix"
    ]
  },
  "packageManager": "bun@1.4.3"
}
