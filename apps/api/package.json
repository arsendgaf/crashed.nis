{
  "name": "@crashed-nis/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types --include-runtime=false --env-interface CloudflareBindings",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint src tests",
    "format": "oxfmt --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@crashed-nis/types": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.13",
    "hono": "^4.13.13",
    "ky": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "wrangler": "^4.151.1"
  }
}
